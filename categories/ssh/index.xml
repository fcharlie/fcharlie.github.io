&lt;div class="highlight"&gt;&lt;pre tabindex="0" style="color:#1d2432;-moz-tab-size:4;-o-tab-size:4;tab-size:4;display:grid;"&gt;&lt;code class="language-shell" data-lang="shell"&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;ssh git@localhost &lt;span style="color:#58a1dd"&gt;echo&lt;/span&gt; &lt;span style="color:#a6be9d"&gt;&amp;#34;There are spaces in the statement&amp;#34;&lt;/span&gt; &lt;span style="color:#ff636f"&gt;done&lt;/span&gt;
